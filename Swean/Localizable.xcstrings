    "privacy.apple.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, updates and – if you allow it – crash reports are handled by Apple. Apple's privacy policy applies to that."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads, Updates und – falls du es erlaubst – Absturzberichte wickelt Apple ab. Dafür gilt die Datenschutzerklärung von Apple."
          }
        }
      }
    },
    "privacy.apple.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store"
          }
        }
      }
    },
    "privacy.contact.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For questions about privacy, you'll find the contact details in the legal notice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Fragen zum Datenschutz findest du die Kontaktdaten im Impressum."
