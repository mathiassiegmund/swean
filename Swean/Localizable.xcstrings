          }
        }
      }
    },
    "privacy.local.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean remembers which photos you have already reviewed or moved to the trash, as well as your appearance setting. This information is stored only on your device and is removed when you delete the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean merkt sich, welche Fotos du schon angesehen oder in den Papierkorb gelegt hast, und deine Darstellungs-Einstellung. Diese Angaben liegen nur auf deinem Gerät und werden gelöscht, wenn du die App löschst."
          }
        }
      }
    },
    "privacy.local.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data on Your Device"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten auf deinem Gerät"
          }
        }
      }
    },
    "privacy.none.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean has no servers, no account, no analytics, no advertising and no third-party SDKs, and makes no network connections of its own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean hat keine Server, kein Konto, keine Analyse-Tools, keine Werbung und keine Drittanbieter-SDKs und baut selbst keine Internetverbindungen auf."
          }
        }
      }
    },
    "privacy.none.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Tracking"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Tracking"
          }
        }
      }
    },
    "privacy.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean accesses your photo library only on your device, to show you your photos and to carry out what you choose: filing photos into albums, marking favorites and deleting. To find series of similar photos, Swean analyzes small previews on your device. Your photos never leave your device. Photos stored in iCloud are downloaded by iOS itself so they can be displayed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean greift nur auf deinem Gerät auf deine Fotomediathek zu, um dir deine Fotos zu zeigen und auszuführen, was du wählst: Fotos in Alben einsortieren, als Favorit markieren und löschen. Um Serien ähnlicher Fotos zu finden, analysiert Swean kleine Vorschaubilder auf deinem Gerät. Deine Fotos verlassen dein Gerät nicht. Fotos, die in iCloud liegen, lädt iOS selbst herunter, damit sie angezeigt werden können."
          }
        }
      }
    },
    "privacy.photos.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos"
          }
        }
      }
    },
    "privacy.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean does not collect, store or share any personal data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swean erhebt, speichert und teilt keine personenbezogenen Daten."
          }
        }
      }
    }
  },
  "version": "1.0"
}